# Kopieren nach .env (lokal) bzw. als Variablen in Cloudflare Pages eintragen.
# Alles optional – ohne Schlüssel läuft die Seite mit Testzahlungen und E-Mails nur in der Outbox.

# Öffentliche Adresse der Seite (für Links in E-Mails und Stripe)
SITE_URL=http://localhost:1102

# Stripe (Bezahlung Direktbuchung + Artist-Abo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (E-Mail-Versand)
RESEND_API_KEY=
MAIL_FROM=Bunker West <noreply@bunkerwest.de>
TEAM_EMAIL=team@bunkerwest.de

# Cloudflare Turnstile (Spam-Schutz für Formulare)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Passwort-Hashing (Cloudflare Free: niedriger halten wegen CPU-Limit)
PBKDF2_ITER=60000
